# Python / tooling
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# uv virtualenvs (no leading slash: matches the workspace root and every package)
.venv/

# secrets
.env
.env.*
!.example.env

# editor / OS
.vscode/
.idea/
.DS_Store

# HPC job logs
*.o[0-9]*
*.e[0-9]*
*.log
logs/

# large or regenerable artifacts
*.wav
*.flac
*.mp3
checkpoints/
*.pt
*.safetensors
*.ckpt

# run outputs and data files. JSONL is ignored everywhere except package source
# and tests, so config files (e.g. a task's replacements.jsonl) and fixtures stay tracked.
# Un-ignore a specific results file with a `!path` line if a run's scores should be kept in git.
outputs/**/audio/
outputs/**/metadata.json
outputs/**/summary.json
*.parquet
*.jsonl
!packages/*/src/**/*.jsonl
!packages/*/tests/**/*.jsonl
# a run started from inside a package's src/ would otherwise be re-included by the line above
packages/*/src/**/outputs/

# dataset snapshot pulled by `audio-evaluation download`; the dataset card lives on the Hub only
data/seahelm_audio_data/

# staged prompt audio sets (the frozen sets live in seahelm-audio-uploader / HF; only manifests are tracked here)
data/audio_sets/

# sparse checkout of upstream aisingapore/SEA-HELM pulled by downloader.py (shas recorded in prompts.jsonl instead)
data/upstream/
